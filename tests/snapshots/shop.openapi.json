      "Category": {
        "enum": [
          "books",
          "home-appliances"
        ],
        "type": "string"
      },
      "ListQuery": {
        "description": "List filters.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ],
            "description": "Filter by category."
          },
          "limit": {
            "anyOf": [
              {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Page size, 1..=50.",
            "maximum": 50,
            "minimum": 1
          }
        },
        "required": [],
        "type": "object"
      },
      "NewProduct": {
        "additionalProperties": false,
        "description": "Payload to create a product.",
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "description": "Category."
          },
          "name": {
            "description": "1..=80 printable characters.",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[\\x20-\\x7E]*$",
            "type": "string"
          },
          "price_cents": {
            "description": "Price in cents, 1..=1_000_000.",
            "format": "uint32",
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "price_cents",
          "category"
        ],
        "type": "object"
      },
      "Product": {
        "description": "A product.",
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "description": "Category."
          },
          "id": {
            "description": "Identifier.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "price_cents": {
            "description": "Price in cents.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "price_cents",
          "category"
        ],
        "type": "object"
      },
      "ProductPage": {
        "description": "Paged list response.",
        "properties": {
          "items": {
            "description": "Items.",
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array"
          },
          "total": {
            "description": "Total matching items.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      }
    }
  },
