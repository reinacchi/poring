digraph "SecureApp" {
  rankdir=TB;
  node [fontname="Helvetica", fontsize=10];
  "receive" [label="receive", shape=circle];
  "match" [label="route match", shape=diamond];
  "send" [label="send response", shape=circle];
  "post_notes.respond" [label="POST /notes: map response", shape=box];
  "post_notes.cors" [label="CORS origin check", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.deny.403" [label="deny 403", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.auth" [label="authenticate (trusted authenticator)", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.deny.401" [label="deny 401", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.authz" [label="authorise scopes=['notes:write']", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.rate_limit" [label="rate limit 2/1000ms by principal", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.deny.429" [label="deny 429", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.deny.503" [label="deny 503", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.csrf" [label="CSRF check (cookie auth, unsafe method)", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.body_gate" [label="body gate <= 1024 bytes, types=['application/json']", shape=parallelogram, style=filled, fillcolor="#e8f0fe"];
  "post_notes.deny.413" [label="deny 413", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.deny.415" [label="deny 415", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.short_circuit" [label="early response from hook", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.before.0" [label="before[global] record", shape=box];
  "post_notes.reject" [label="extractor rejection (4xx)", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "post_notes.extract.0" [label="extract Principal<Authenticated> (principal)", shape=box];
  "post_notes.extract.1" [label="extract State<Notes> (state)", shape=box];
  "post_notes.extract.2" [label="extract Json<NewNote> (json)", shape=box];
  "post_notes.validate.2" [label="validate Json<NewNote>", shape=box];
  "post_notes.handler" [label="handler create_note", shape=box3d];
  "post_notes.error" [label="handler error -> IntoResponse", shape=octagon, style=filled, fillcolor="#fde2e2"];
  "receive" -> "match" [style=solid];
  "match" -> "post_notes.cors" [style=solid, label="POST /notes"];
  "post_notes.cors" -> "post_notes.deny.403" [style=dashed, label="403 origin not allowed"];
  "post_notes.deny.403" -> "send" [style=solid];
  "post_notes.cors" -> "post_notes.auth" [style=solid];
  "post_notes.auth" -> "post_notes.deny.401" [style=dashed, label="401 unauthenticated"];
  "post_notes.deny.401" -> "send" [style=solid];
  "post_notes.auth" -> "post_notes.authz" [style=solid];
  "post_notes.authz" -> "post_notes.deny.403" [style=dashed, label="403 forbidden"];
  "post_notes.authz" -> "post_notes.rate_limit" [style=solid];
  "post_notes.rate_limit" -> "post_notes.deny.429" [style=dashed, label="429 too many requests"];
  "post_notes.deny.429" -> "send" [style=solid];
  "post_notes.rate_limit" -> "post_notes.deny.503" [style=dashed, label="503 rate limiter full"];
  "post_notes.deny.503" -> "send" [style=solid];
  "post_notes.rate_limit" -> "post_notes.csrf" [style=solid];
  "post_notes.csrf" -> "post_notes.deny.403" [style=dashed, label="403 csrf"];
  "post_notes.csrf" -> "post_notes.body_gate" [style=solid];
  "post_notes.body_gate" -> "post_notes.deny.413" [style=dashed, label="413 payload too large"];
  "post_notes.deny.413" -> "send" [style=solid];
  "post_notes.body_gate" -> "post_notes.deny.415" [style=dashed, label="415 unsupported media type"];
  "post_notes.deny.415" -> "send" [style=solid];
  "post_notes.body_gate" -> "post_notes.before.0" [style=solid];
  "post_notes.before.0" -> "post_notes.short_circuit" [style=dashed, label="Err/early return"];
  "post_notes.short_circuit" -> "post_notes.respond" [style=solid];
  "post_notes.reject" -> "post_notes.respond" [style=solid];
  "post_notes.before.0" -> "post_notes.extract.0" [style=solid];
  "post_notes.extract.0" -> "post_notes.reject" [style=dashed, label="reject"];
  "post_notes.extract.0" -> "post_notes.extract.1" [style=solid];
  "post_notes.extract.1" -> "post_notes.reject" [style=dashed, label="reject"];
  "post_notes.extract.1" -> "post_notes.extract.2" [style=solid];
  "post_notes.extract.2" -> "post_notes.reject" [style=dashed, label="reject"];
  "post_notes.extract.2" -> "post_notes.validate.2" [style=solid];
  "post_notes.validate.2" -> "post_notes.reject" [style=dashed, label="422 invalid"];
  "post_notes.validate.2" -> "post_notes.handler" [style=solid];
  "post_notes.handler" -> "post_notes.deny.503" [style=dashed, label="503 timeout"];
  "post_notes.handler" -> "post_notes.error" [style=dashed, label="Err"];
  "post_notes.error" -> "post_notes.respond" [style=solid];
  "post_notes.handler" -> "post_notes.respond" [style=solid];
  "post_notes.respond" -> "send" [style=solid];
}
